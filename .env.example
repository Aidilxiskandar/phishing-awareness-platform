# Copy to .env and fill in. .env is git-ignored.

# Environment: dev | staging | prod. In prod the app refuses to boot unless
# SECRET_KEY and ADMIN_PASSWORD are set and SMTP is configured, and it hides /docs.
ENV=dev

# Public base URL the tracked email links point back to.
BASE_URL=http://127.0.0.1:8000

# --- Admin login ---
# The single admin credential for the dashboard. In dev, if ADMIN_PASSWORD is
# blank the app falls back to "phishguard-dev". In prod it MUST be set.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Session-cookie signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# In dev an ephemeral key is used if blank (sessions reset on restart). Required in prod.
SECRET_KEY=

# --- Email sending ---
# If SMTP_HOST is blank, the app runs in DRY-RUN mode: it prints each email + its
# tracking URLs to the console instead of sending. No mail server needed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Optional: restrict real sends to these recipient domains (comma-separated).
ALLOWED_RECIPIENT_DOMAINS=

# --- Detection ---
# Window (seconds) after send during which a click with no browser (JS) confirmation
# is treated as a likely automated scan rather than a human.
SCANNER_TIME_WINDOW_SECONDS=15

# --- Infrastructure ---
# Override the database (defaults to a SQLite file in the repo). e.g. for Postgres:
#   DATABASE_URL=postgresql+psycopg://user:pass@host/dbname
DATABASE_URL=

# Comma-separated proxy IPs whose X-Forwarded-For header is trusted for the client
# IP in the evidence log. Leave blank unless the app sits behind a known proxy.
TRUSTED_PROXIES=
