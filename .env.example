# Copy to .env and fill in. .env is git-ignored.

# Public base URL the tracked email links point back to.
# For local testing, keep the default. In a real drill this is your server's address.
BASE_URL=http://127.0.0.1:8000

# Email sending. If SMTP_HOST is left blank, the app runs in DRY-RUN mode:
# it prints each email + its tracking URLs to the console instead of sending.
# This lets you test the whole flow with no mail server.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Window (seconds) after send during which a click with no browser (JS) confirmation
# is treated as a likely automated scan rather than a human. See app/detection.py.
SCANNER_TIME_WINDOW_SECONDS=15
